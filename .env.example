# ============ Backend ============
# SQLite for local dev (default). PostgreSQL in docker-compose.
# SQLite:  DATABASE_URL=sqlite:///./app.db
# Postgres: DATABASE_URL=postgresql+psycopg2://portfolio:portfolio@localhost:5432/portfolio
DATABASE_URL=sqlite:///./app.db

# Secret key for JWT signing. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File uploads directory (relative to backend/)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Password reset code lifetime (minutes)
PASSWORD_RESET_TTL_MINUTES=15

# SMTP for password reset emails (optional).
# When not set, in development mode the code is returned in the API response
# and shown in the UI instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

ENV=development

# ============ Frontend ============
VITE_API_BASE_URL=/api/v1
